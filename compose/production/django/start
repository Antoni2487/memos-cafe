#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python /app/manage.py collectstatic --noinput
python /app/manage.py migrate --noinput

# Servidor ASGI: atiende HTTP y los WebSocket de Cocina/meseros en el mismo
# proceso (el plan gratuito de Render da uno solo). Con WSGI (gunicorn
# config.wsgi) los WebSocket no funcionaban.
# --proxy-headers: toma la IP real del cliente de X-Forwarded-For (Render
# esta detras de un proxy); la usan los limites de uso de la API.
# Render (y otros PaaS) asignan el puerto via $PORT; se cae a 5000 en
# local/docker-compose donde no se define.
exec daphne \
    --bind 0.0.0.0 \
    --port "${PORT:-5000}" \
    --proxy-headers \
    config.asgi:application
